      "showLegend": true,
      "xAxisVal": "timestamp",
      "foxglovePanelTitle": "Tracking error — cross-track (m) + heading (deg)"
    },
    "Plot!solve": {
      "paths": [
        { "value": "/controller/solve_time_ms.data", "enabled": true, "color": "#00e5ff", "label": "MPC solve (ms)" }
