      "showLegend": true,
      "minYValue": -1.05,
      "maxYValue": 1.05,
      "xAxisVal": "timestamp",
      "foxglovePanelTitle": "Control commands (throttle / brake / steer)"
    },
    "Plot!error": {
      "paths": [
        { "value": "/controller/cross_track_error.data", "enabled": true, "color": "#ff4081", "label": "cross-track (m)" },
