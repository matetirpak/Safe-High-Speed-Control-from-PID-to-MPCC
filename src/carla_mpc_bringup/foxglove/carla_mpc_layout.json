    "Plot!cmd": {
      "paths": [
        { "value": "/controller/throttle.data", "enabled": true, "color": "#00e676", "label": "throttle" },
        { "value": "/controller/brake.data", "enabled": true, "color": "#ff5252", "label": "brake" },
        { "value": "/controller/steer.data", "enabled": true, "color": "#40c4ff", "label": "steer" }
